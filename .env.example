# ─── RYO-CHAN builder credential ──────────────────────────────────────────────
# Of these, only RYO_MCP_KEY authenticates — it is sent as `Authorization: Bearer`
# on every upstream call. The rest are recorded so the loaded credential is
# identifiable and its expiry visible without opening the RYO dashboard.
#
# Never commit a populated credential. `.env` is gitignored; this file is not. The
# guide's rule: commit .env.example, never a populated .env.
RYO_MCP_URL=https://app-ryochan.com/api/mcp

# "Credential" — the secret. This is the one that authenticates.
RYO_MCP_KEY=
# "Label" — which key this is, for your own records.
RYO_KEY_LABEL=
# "Key ID" — public identifier, safe to quote in a support request.
RYO_KEY_ID=
# "Expires At" — ISO-8601, e.g. 2026-12-31T23:59:59Z
RYO_KEY_EXPIRES_AT=
# "Rate Per Minute" — the published ceiling for this key.
RYO_RATE_PER_MINUTE=

# ─── Transport ────────────────────────────────────────────────────────────────
# http   use RYO_MCP_URL + RYO_MCP_KEY above (live RYO-CHAN, six metered tools)
# stdio  use the local conformance peer — a REAL MCP server over real stdio that
#        publishes the same six tools and the same public envelope as production.
#        This is the default so a fresh clone runs end to end with no credential.
#
# It is NOT a fallback: the engine only ever uses what is configured here, and if the
# configured peer is unreachable it fails loudly rather than substituting anything.
# The dashboard header always names the live transport, so which peer is in use is
# visible at a glance.
RYO_MCP_TRANSPORT=stdio
RYO_MCP_COMMAND=npx
RYO_MCP_ARGS=tsx apps/engine/src/conformance/server.ts

# ─── Engine ───────────────────────────────────────────────────────────────────
ENGINE_PORT=4000
LEDGER_PATH=./kura_flight_recorder.db
RYO_REQUEST_TIMEOUT_MS=10000

# ─── Upstream retry policy (429 / 503 / network errors) ───────────────────────
# Retry-After is honoured when the server sends it; otherwise exponential backoff with
# FULL jitter. 400 and 401 are never retried — the guide forbids retrying invalid
# arguments, and waiting cannot fix a bad credential.
RYO_RETRY_MAX_ATTEMPTS=4
RYO_RETRY_BASE_DELAY_MS=500
RYO_RETRY_MAX_DELAY_MS=20000

# Minimum gap between consecutive upstream calls. Defaults to 60000/RYO_RATE_PER_MINUTE.
# Measured against live RYO: bursts are refused while /whoami still reports the full
# per-minute quota remaining, so the binding constraint is burst rate rather than volume.
# 3000 holds steady; leave unset to derive it from the published ceiling.
RYO_MIN_CALL_INTERVAL_MS=

# ─── Deterministic invariant thresholds ───────────────────────────────────────
# Measured against live RYO over HTTPS: round trips run 550-1100ms at a realistic
# evaluation pace, so 1200 leaves almost no headroom and vetoes healthy data under load.
# Raise it to ~2500 when pointing at the live endpoint; 1200 suits a local peer.
INV_MAX_LATENCY_MS=1200
# How stale the upstream `as_of` observation may be before a result is refused.
INV_MAX_AS_OF_AGE_MS=300000

# ─── Fractional Kelly sizing ──────────────────────────────────────────────────
KELLY_BANKROLL_USD=100000
KELLY_FRACTION=0.25
KELLY_PAYOFF_RATIO=1.5
# Lower bound is derived, not configured: p_min = 1/(1+b) = break-even.
KELLY_P_MAX=0.55
# ATR/price at which the volatility score reaches zero.
KELLY_MAX_ATR_PCT=0.15
# ATR/price at or above which sizing is refused outright rather than extrapolated.
KELLY_HYPER_VOL_ATR_PCT=0.5
KELLY_MAX_POSITION_PCT=0.05

# ─── Telemetry loops ──────────────────────────────────────────────────────────
# The heartbeat polls the free, unauthenticated /health endpoint. Set
# PULSE_SWEEP_TOOLS=1 to fan out across all six metered tools instead — useful against
# the conformance peer, expensive against production.
PULSE_INTERVAL_MS=15000
PULSE_SWEEP_TOOLS=0

# Boot-time measurement-path probe. Costs one tool call; set 0 to skip. Without it a
# change to RYO's `data` shape degrades into silent, universal refusal.
EVIDENCE_PROBE=1
EVALUATION_INTERVAL_MS=15000
AUTO_EVALUATE=1

# Candidate symbols. RYO publishes no supported_tokens tool, so this list is yours.
KURA_WATCHLIST=SOL,BTC,ETH,AVAX,BNB
