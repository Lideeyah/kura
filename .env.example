# ─── Live RYO-CHAN MCP endpoint ───────────────────────────────────────────────
# Set RYO_MCP_TRANSPORT=http and point RYO_MCP_URL at the real endpoint.
# The engine has no offline mode: if this peer is unreachable, calls fail loudly.
RYO_MCP_TRANSPORT=http
RYO_MCP_URL=https://your-ryo-chan-endpoint.example/mcp
RYO_MCP_TOKEN=

# ─── Local verification against the conformance peer (real MCP over stdio) ────
# RYO_MCP_TRANSPORT=stdio
# RYO_MCP_COMMAND=npx
# RYO_MCP_ARGS=tsx apps/engine/src/conformance/server.ts

# ─── Engine ───────────────────────────────────────────────────────────────────
ENGINE_PORT=4000
LEDGER_PATH=./kura_flight_recorder.db
RYO_REQUEST_TIMEOUT_MS=10000

# ─── Deterministic invariant thresholds ───────────────────────────────────────
INV_MAX_LATENCY_MS=1200
INV_MIN_LIQUIDITY_USD=1000000

# ─── Fractional Kelly sizing ──────────────────────────────────────────────────
KELLY_BANKROLL_USD=100000
KELLY_FRACTION=0.25
KELLY_PAYOFF_RATIO=1.5
# Lower bound is derived, not configured: p_min = 1/(1+b) = break-even.
KELLY_P_MAX=0.55
KELLY_MAX_POSITION_PCT=0.05

# ─── Telemetry loops ──────────────────────────────────────────────────────────
PULSE_INTERVAL_MS=5000
EVALUATION_INTERVAL_MS=15000
AUTO_EVALUATE=1
